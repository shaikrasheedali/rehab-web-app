{
  "name": "thirumala-server",
  "version": "1.0.0",
  "description": "Backend API Server for Sri Thirumala Rehabilitation Centre & Nursing Home",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "seed": "node prisma/seed.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --detectOpenHandles --forceExit"
  },
  "dependencies": {
    "@prisma/client": "6.4.1",
    "cors": "2.8.5",
    "decimal.js": "10.5.0",
    "dompurify": "3.2.4",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "jsdom": "26.0.0",
    "morgan": "1.10.0",
    "multer": "1.4.5-lts.1",
    "swagger-ui-express": "5.0.1",
    "yamljs": "0.3.0"
  },
  "devDependencies": {
    "cross-env": "7.0.3",
    "jest": "29.7.0",
    "nodemon": "3.1.9",
    "prisma": "6.4.1",
    "supertest": "7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true
  }
}
