datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id           String    @id
  username     String    @unique
  passwordHash String
  name         String
  role         String    @default("ADMIN")
  active       Boolean   @default(true)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Service {
  id         String   @id // e.g. "svc-physio", "svc-neuro"
  name       String
  kind       String   // "in-package" | "off-package"
  rate       Float
  summary    String
  content    String
  benefits   String   @default("[]") // JSON string array
  images     String   @default("[]") // JSON string array
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Package {
  id         String   @id // e.g. "pkg-recovery", "pkg-stroke"
  name       String
  rate       Float
  benefits   String   @default("[]") // JSON string array
  serviceIds String   @default("[]") // JSON string array of Service IDs
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Inquiry {
  id                  String   @id
  patient             String
  contact             String
  phone               String
  email               String?
  need                String
  date                String
  start               String?
  duration            String
  language            String   @default("English")
  room                String   @default("No preference")
  currentLocation     String   @default("At home")
  packageId           String?
  offPackageServiceIds String  @default("[]") // JSON string array
  status              String   @default("New") // "New" | "Contacted" | "Quote sent" | "Admitted"
  priority            String   @default("Normal") // "Normal" | "High" | "Medium"
  basket              String   @default("[]") // JSON string array
  consent             Boolean  @default(true)
  contactRequest      Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Accommodation {
  id        String   @id // e.g. "ROOM-101", "BED-201-A"
  type      String   // "Room" | "Bed"
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Admission {
  id                  String   @id // e.g. "ADM-1042"
  patient             String
  age                 Int?
  gender              String?
  contact             String
  phone               String
  address             String?
  admissionDate       String
  expectedDischarge   String?
  actualDischarge     String?
  stayType            String   @default("staying") // "staying" | "non-staying"
  accommodationId     String?
  packageId           String?
  offPackageServiceIds String  @default("[]") // JSON string array
  status              String   @default("Admitted") // "Admitted" | "Discharged"
  need                String?
  language            String?
  roomPreference      String?
  currentLocation     String?
  medicalSummary      String?
  dischargeSummary    String?
  sourceInquiryId     String?
  finalBill           String?  // JSON string
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  progressRecords     ResidentProgress[]
  billingProfile      BillingProfile?
  payments            Payment[]
}

model ResidentProgress {
  id          String    @id
  admissionId String
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  at          DateTime  @default(now())
  author      String
  status      String
  category    String
  note        String
  createdAt   DateTime  @default(now())
}

model BillingProfile {
  id                  String    @id
  admissionId         String    @unique
  admission           Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  start               String
  end                 String
  packageId           String?
  packageDiscountType String    @default("percent")
  packageDiscount     Float     @default(0)
  addOns              String    @default("[]") // JSON string array of add-on lines
  customLines         String    @default("[]") // JSON string array of custom lines
  globalType          String    @default("percent")
  globalDiscount      Float     @default(0)
  tax                 Float     @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Payment {
  id          String    @id
  admissionId String
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  amount      Float
  at          DateTime  @default(now())
  note        String?
  method      String    @default("UPI")
  createdAt   DateTime  @default(now())
}

model MediaItem {
  id          String   @id
  section     String   // "blog" | "testimonial" | "post"
  subtype     String   // "article" | "testimonial-video" | "youtube-video" | "instagram-post" | "instagram-reel" | "facebook-reel" | "facebook-post" | "x-post" | "image"
  title       String
  excerpt     String?
  caption     String?
  content     String
  mediaUrl    String?
  image       String?
  images      String   @default("[]") // JSON string array
  author      String
  publishedAt String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
