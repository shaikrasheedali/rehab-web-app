datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id           String    @id @db.VarChar(64)
  username     String    @unique @db.VarChar(64)
  passwordHash String    @db.VarChar(255)
  name         String    @db.VarChar(128)
  role         String    @default("ADMIN") @db.VarChar(32)
  active       Boolean   @default(true)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Service {
  id         String   @id @db.VarChar(64)
  name       String   @db.VarChar(191)
  kind       String   @db.VarChar(32)
  rate       Float
  summary    String   @db.Text
  content    String   @db.LongText
  benefits   String   @default("[]") @db.VarChar(2048)
  images     String   @default("[]") @db.VarChar(2048)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Package {
  id         String   @id @db.VarChar(64)
  name       String   @db.VarChar(191)
  rate       Float
  benefits   String   @default("[]") @db.VarChar(2048)
  serviceIds String   @default("[]") @db.VarChar(2048)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Inquiry {
  id                  String   @id @db.VarChar(64)
  patient             String   @db.VarChar(191)
  contact             String   @db.VarChar(191)
  phone               String   @db.VarChar(32)
  email               String?  @db.VarChar(191)
  need                String   @db.Text
  date                String   @db.VarChar(32)
  start               String?  @db.VarChar(32)
  duration            String   @db.VarChar(64)
  language            String   @default("English") @db.VarChar(32)
  room                String   @default("No preference") @db.VarChar(64)
  currentLocation     String   @default("At home") @db.VarChar(64)
  packageId           String?  @db.VarChar(64)
  offPackageServiceIds String  @default("[]") @db.VarChar(2048)
  status              String   @default("New") @db.VarChar(32)
  priority            String   @default("Normal") @db.VarChar(32)
  basket              String   @default("[]") @db.VarChar(2048)
  consent             Boolean  @default(true)
  contactRequest      Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Accommodation {
  id        String   @id @db.VarChar(64)
  type      String   @db.VarChar(32)
  label     String   @db.VarChar(128)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Admission {
  id                  String   @id @db.VarChar(64)
  patient             String   @db.VarChar(191)
  age                 Int?
  gender              String?  @db.VarChar(32)
  contact             String   @db.VarChar(191)
  phone               String   @db.VarChar(32)
  address             String?  @db.Text
  admissionDate       String   @db.VarChar(32)
  expectedDischarge   String?  @db.VarChar(32)
  actualDischarge     String?  @db.VarChar(32)
  stayType            String   @default("staying") @db.VarChar(32)
  accommodationId     String?  @db.VarChar(64)
  packageId           String?  @db.VarChar(64)
  offPackageServiceIds String  @default("[]") @db.VarChar(2048)
  status              String   @default("Admitted") @db.VarChar(32)
  need                String?  @db.Text
  language            String?  @db.VarChar(32)
  roomPreference      String?  @db.VarChar(64)
  currentLocation     String?  @db.VarChar(64)
  medicalSummary      String?  @db.Text
  dischargeSummary    String?  @db.Text
  sourceInquiryId     String?  @db.VarChar(64)
  finalBill           String?  @db.LongText
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  progressRecords     ResidentProgress[]
  billingProfile      BillingProfile?
  payments            Payment[]
}

model ResidentProgress {
  id          String    @id @db.VarChar(64)
  admissionId String    @db.VarChar(64)
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  at          DateTime  @default(now())
  author      String    @db.VarChar(128)
  status      String    @db.VarChar(64)
  category    String    @db.VarChar(64)
  note        String    @db.Text
  createdAt   DateTime  @default(now())
}

model BillingProfile {
  id                  String    @id @db.VarChar(64)
  admissionId         String    @unique @db.VarChar(64)
  admission           Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  start               String    @db.VarChar(32)
  end                 String    @db.VarChar(32)
  packageId           String?   @db.VarChar(64)
  packageDiscountType String    @default("percent") @db.VarChar(32)
  packageDiscount     Float     @default(0)
  addOns              String    @default("[]") @db.VarChar(2048)
  customLines         String    @default("[]") @db.VarChar(2048)
  globalType          String    @default("percent") @db.VarChar(32)
  globalDiscount      Float     @default(0)
  tax                 Float     @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Payment {
  id          String    @id @db.VarChar(64)
  admissionId String    @db.VarChar(64)
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  amount      Float
  at          DateTime  @default(now())
  note        String?   @db.Text
  method      String    @default("UPI") @db.VarChar(64)
  createdAt   DateTime  @default(now())
}

model MediaItem {
  id          String   @id @db.VarChar(64)
  section     String   @db.VarChar(32)
  subtype     String   @db.VarChar(64)
  title       String   @db.VarChar(255)
  excerpt     String?  @db.Text
  caption     String?  @db.VarChar(255)
  content     String   @db.LongText
  mediaUrl    String?  @db.VarChar(512)
  image       String?  @db.VarChar(512)
  images      String   @default("[]") @db.VarChar(2048)
  author      String   @db.VarChar(128)
  publishedAt String   @db.VarChar(32)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
